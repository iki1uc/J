<script type="module">

// Loader
async function load(path) {
  const res = await fetch(path);
  return res.text();
}

// EINWAHL · CONTINUUM-START
async function continuumStart() {

  const Z    = await load("Z/Z.room");
  const CONT = await load("Z/continium.room");
  const Q    = await load("Q/Q.room");
  const QI   = await load("Q/QI.room");
  const IQQ  = await load("Q/IQQ.room");
  const HESS = await load("H/HESS.room");
  const JUMP = await load("J/J.room");   // ← deine fehlende Einwahl

  window.CONTINUUM = { Z, CONT, Q, QI, IQQ, HESS, JUMP };

  document.getElementById("status").innerText =
    "EINWAHL aktiv:\n" +
    "Z → Q → QI → IQQ → HESS → J → Engine";
}

// AUTOSTART
window.onload = async () => {
  await continuumStart();
};
</script>
